@echo off
rem Affiche les tables, les cles etrangeres, les comptages, les dernieres reservations et l'etat de la flotte (MySQL XAMPP)
cd /d "%~dp0.."
if not exist logs mkdir logs
"C:\xampp\mysql\bin\mysql.exe" -u root --table --force -e "SHOW TABLES; SELECT table_name AS table_source, column_name AS colonne_fk, referenced_table_name AS table_cible FROM information_schema.key_column_usage WHERE table_schema = 'autoloc_db' AND referenced_table_name IS NOT NULL ORDER BY table_name; SHOW CREATE TABLE paiement; SHOW CREATE TABLE vehicule_equipement; SELECT (SELECT COUNT(*) FROM agence) AS agences, (SELECT COUNT(*) FROM vehicule) AS vehicules, (SELECT COUNT(*) FROM equipement) AS equipements, (SELECT COUNT(*) FROM vehicule_equipement) AS liens_equipement, (SELECT COUNT(*) FROM employe) AS employes, (SELECT COUNT(*) FROM client) AS clients, (SELECT COUNT(*) FROM reservation) AS reservations, (SELECT COUNT(*) FROM contrat) AS contrats, (SELECT COUNT(*) FROM paiement) AS paiements, (SELECT COUNT(*) FROM maintenance) AS maintenances; SELECT r.id_reservation AS no, c.email, v.immatriculation, r.date_debut AS depart, r.date_fin AS retour, r.statut, k.montant_total AS montant, IF(k.valide, 'oui', 'non') AS contrat_valide, (SELECT COALESCE(SUM(p.montant), 0) FROM paiement p WHERE p.id_contrat = k.id_contrat) AS paye FROM reservation r JOIN client c ON c.id_client = r.id_client JOIN vehicule v ON v.id_vehicule = r.id_vehicule LEFT JOIN contrat k ON k.id_reservation = r.id_reservation ORDER BY r.id_reservation DESC LIMIT 15; SELECT immatriculation, marque, modele, statut FROM vehicule ORDER BY immatriculation; SELECT identifiant, email, role, IF(actif, 'oui', 'non') AS actif, CONCAT(LEFT(mot_de_passe, 7), '...') AS empreinte_bcrypt FROM utilisateur ORDER BY identifiant; SELECT u.identifiant, j.cree_le, j.expire_le, j.utilise_le, CONCAT(LEFT(j.empreinte, 12), '...') AS empreinte_sha256 FROM jeton_reinitialisation j JOIN utilisateur u ON u.id_utilisateur = j.id_utilisateur ORDER BY j.id_jeton DESC LIMIT 5; SELECT column_type AS type_colonne_role FROM information_schema.columns WHERE table_schema = 'autoloc_db' AND table_name = 'utilisateur' AND column_name = 'role'; SELECT u.email AS compte_client, c.prenom, c.nom, (SELECT COUNT(*) FROM reservation r WHERE r.id_client = c.id_client) AS reservations FROM utilisateur u JOIN client c ON c.id_client = u.id_client WHERE u.role = 'CLIENT' ORDER BY u.id_utilisateur DESC LIMIT 10; SELECT email, cree_le, expire_le, utilise_le, CONCAT(LEFT(empreinte, 12), '...') AS empreinte_sha256 FROM jeton_inscription ORDER BY id_jeton DESC LIMIT 5;" autoloc_db > logs\base.log 2>&1
type logs\base.log
if /i not "%~1"=="nopause" pause
