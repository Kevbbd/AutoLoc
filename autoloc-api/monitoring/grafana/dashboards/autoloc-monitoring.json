{
  "uid": "autoloc-monitoring",
  "title": "AutoLoc — Application Monitoring",
  "description": "Métriques Spring Boot (Actuator + Micrometer) collectées par Prometheus.",
  "tags": [
    "autoloc",
    "spring-boot"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Vitrine AutoLoc",
      "type": "link",
      "url": "http://localhost:8080",
      "icon": "external link",
      "targetBlank": true
    },
    {
      "title": "Prometheus",
      "type": "link",
      "url": "http://localhost:9090/targets",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 8,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## AutoLoc · Supervision en temps réel\nAPI Spring Boot collectée par Prometheus toutes les 5 secondes · [Vitrine AutoLoc](http://localhost:8080) · [Santé de l'API](http://localhost:8080/actuator/health) · [Cibles Prometheus](http://localhost:9090/targets)"
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Débit HTTP (requêtes/s)",
      "description": "Requêtes par seconde, hors appels Actuator (dont la collecte Prometheus).",
      "datasource": {
        "type": "prometheus",
        "uid": "autoloc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "#1089ff"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "autoloc-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"autoloc-api\", uri!~\"/actuator/.*\"}[1m]))",
          "legendFormat": "requêtes/s",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latence HTTP p95",
      "description": "95 % des requêtes répondent plus vite que cette valeur. Nécessite management.metrics.distribution.percentiles-histogram.http.server.requests=true.",
      "datasource": {
        "type": "prometheus",
        "uid": "autoloc-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#01d28e"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "autoloc-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"autoloc-api\", uri!~\"/actuator/.*\"}[5m])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Réponses HTTP par statut",
      "description": "Permet de voir les 200 / 401 / 403 générés pendant les tests Spring Security.",
      "datasource": {
        "type": "prometheus",
        "uid": "autoloc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6c757d"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "200"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#01d28e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "401"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f5a623"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "403"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e5484d"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "404"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6c757d"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "500"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e1f2f"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "autoloc-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"autoloc-api\", uri!~\"/actuator/.*\"}[1m]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mémoire JVM utilisée",
      "description": "Heap (objets Java) et non-heap (classes, code compilé).",
      "datasource": {
        "type": "prometheus",
        "uid": "autoloc-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "#1089ff"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "heap"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1089ff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nonheap"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#01d28e"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "autoloc-prometheus"
          },
          "expr": "sum by (area) (jvm_memory_used_bytes{job=\"autoloc-api\"})",
          "legendFormat": "{{area}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU du processus Spring Boot",
      "description": "Part de CPU utilisée par la JVM (1 = 100 %).",
      "datasource": {
        "type": "prometheus",
        "uid": "autoloc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "#1089ff"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "autoloc-prometheus"
          },
          "expr": "process_cpu_usage{job=\"autoloc-api\"}",
          "legendFormat": "CPU",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Threads JVM actifs",
      "description": "Nombre de threads vivants dans la JVM.",
      "datasource": {
        "type": "prometheus",
        "uid": "autoloc-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "#1089ff"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "autoloc-prometheus"
          },
          "expr": "jvm_threads_live_threads{job=\"autoloc-api\"}",
          "legendFormat": "threads",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Uptime de l'application",
      "description": "Temps écoulé depuis le démarrage de Spring Boot.",
      "datasource": {
        "type": "prometheus",
        "uid": "autoloc-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 19,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#01d28e"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "autoloc-prometheus"
          },
          "expr": "process_uptime_seconds{job=\"autoloc-api\"}",
          "legendFormat": "uptime",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    }
  ]
}